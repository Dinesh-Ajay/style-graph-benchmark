# Select platforms to run. Leave blank to run every configured platform.
BENCHMARK_PLATFORMS=cognodb,neo4j,memgraph,arangodb,neptune

# Recreate benchmark data before each platform run. Set false to measure reads only.
RESET_DATABASE=true
DATASET_EDGE_LIMIT=150000
WARMUP_ITERATIONS=15
MEASURED_ITERATIONS=100
CONCURRENT_CLIENTS=10
CONCURRENT_OPERATIONS_PER_CLIENT=20
WRITE_RATIO=0.10
QUERY_TIMEOUT_MS=30000

# CognoDB Cloud (Bolt/Cypher)
COGNODB_URI=bolt://host:7687
COGNODB_USERNAME=your_username
COGNODB_PASSWORD=your_password
COGNODB_DATABASE=default

# Neo4j AuraDB (Bolt/Cypher)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Memgraph Cloud (Bolt/Cypher)
MEMGRAPH_URI=bolt+s://host:7687
MEMGRAPH_USERNAME=memgraph
MEMGRAPH_PASSWORD=your_password
MEMGRAPH_DATABASE=memgraph

# ArangoDB Cloud (HTTP/AQL)
ARANGODB_URL=https://host:8529
ARANGODB_DATABASE=benchmark
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=your_password

# Amazon Neptune openCypher HTTP endpoint. For a FalkorDB Bolt endpoint, set
# NEPTUNE_MODE=bolt and provide URI/credentials below.
NEPTUNE_MODE=http
NEPTUNE_QUERY_URL=https://your-neptune-endpoint:8182/openCypher
NEPTUNE_HEADERS_JSON={}
NEPTUNE_URI=bolt://host:7687
NEPTUNE_USERNAME=
NEPTUNE_PASSWORD=
NEPTUNE_DATABASE=neptune

